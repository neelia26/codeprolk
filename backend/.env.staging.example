# Copy this file to backend/.env.staging on the VM and replace every value.
POSTGRES_USER=codeprolk_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=codeprolk_staging
DATABASE_URL=postgresql://codeprolk_staging:replace-with-a-long-random-password@postgres:5432/codeprolk_staging

JWT_SECRET=replace-with-a-separate-long-random-secret
BACKEND_PORT=8000
FRONTEND_URL=https://staging.codeprolk.com
PASSWORD_RESET_TOKEN_MINUTES=30

# Leave SMTP blank if staging must not send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@codeprolk.com
SMTP_TLS=true

ADMIN_USERNAME=staging-admin
ADMIN_EMAIL=replace-with-staging-admin-email
ADMIN_PASSWORD=replace-with-a-strong-staging-admin-password
ADMIN_ROLE=admin
